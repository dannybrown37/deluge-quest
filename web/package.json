{
  "name": "web",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "vendor:pyodide": "node scripts/vendor-pyodide.mjs",
    "predev": "npm run vendor:pyodide",
    "dev": "astro dev",
    "prebuild": "npm run vendor:pyodide",
    "build": "astro build",
    "preview": "astro preview",
    "astro": "astro",
    "lint": "biome check src/",
