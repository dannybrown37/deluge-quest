    "astro": "^7.3.5",
    "music-metadata": "^11.16.0",
    "svelte": "^5.57.1",
    "typescript": "^6.0.3"
  },
  "allowScripts": {
    "esbuild": true
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.14",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@testing-library/svelte": "^5.4.2",
    "@vitest/coverage-v8": "^5.0.1",
    "fake-indexeddb": "6.2.5",
    "happy-dom": "^20.14.5",
    "pyodide": "0.27.7",
    "svelte-check": "^4.7.6",
    "vitest": "^5.0.0"
  }
