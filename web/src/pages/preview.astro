---
import BaseLayout from '../layouts/BaseLayout.astro';
import SongPreview from '../components/SongPreview.svelte';
---

<BaseLayout title="Song Preview" description="Preview your Deluge song arrangement — clips, instruments, playback.">
  <section class="page-section">
    <div class="page-header">
      <h1 class="page-title">Song Preview</h1>
      <p class="page-desc">Preview your Deluge arrangement — see clips, instruments, and song structure, and hear it in the browser.</p>
    </div>
    <SongPreview client:load />
  </section>
</BaseLayout>

<style>
  .page-section {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .page-title {
    font-family: 'DM Mono', monospace;
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
</style>
