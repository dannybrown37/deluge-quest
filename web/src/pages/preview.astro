---
import BaseLayout from '../layouts/BaseLayout.astro';
import SongPreview from '../components/SongPreview.svelte';
---

<BaseLayout title="Song Preview" description="Preview your Deluge song arrangement — clips, instruments, playback.">
  <section class="page-section">
    <div class="page-header">
      <h1 class="page-title">Song Preview</h1>
      <p class="page-desc">When looking at XML files on a computer, it's easy to forget which song is which, especially for in-progress tracks that are just saved as numbers. This tool is an experiment to try to play Deluge tracks in the browser. It works best with tracks with arrangements but makes an attempt at clip-only tracks. The patches and samples won't sound right, but the goal is just to be an easy reference tool, not to 1:1 recreate Deluge tracks. Sometimes the renditions can sound pretty cool, though (others are unlistenable, it's a coin-toss).</p>
    </div>
    <SongPreview client:load />
  </section>
</BaseLayout>

<style>
  .page-section {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .page-title {
    font-family: 'DM Mono', monospace;
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
</style>
