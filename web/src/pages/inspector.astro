---
import BaseLayout from '../layouts/BaseLayout.astro';
import SongInspector from '../components/SongInspector.svelte';
---

<BaseLayout title="Song Inspector" description="Visualize your Deluge song arrangement — clips, instruments, structure.">
  <section class="page-section">
    <div class="page-header">
      <h1 class="page-title">Song Inspector</h1>
      <p class="page-desc">Visualize your Deluge arrangement as a timeline — see clips, instruments, and song structure without a DAW.</p>
    </div>
    <SongInspector client:load />
  </section>
</BaseLayout>

<style>
  .page-section {
    max-width: 960px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }
  .page-header {
    text-align: center;
    margin-bottom: 2rem;
  }
  .page-title {
    font-family: 'DM Mono', monospace;
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
  }
</style>
