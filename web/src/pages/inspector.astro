---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout title="Song Inspector" description="Visualize your Deluge song arrangement — clips, instruments, structure.">
  <section class="page-header">
    <h1 class="page-title">Song Inspector</h1>
    <p class="page-desc">Visualize your Deluge arrangement as a timeline — see clips, instruments, and song structure without a DAW.</p>
    <p class="coming">Coming in the next update.</p>
  </section>
</BaseLayout>

<style>
  .page-header {
    max-width: 600px;
    margin: 0 auto;
    padding: 5rem 1.5rem;
    text-align: center;
  }
  .page-title {
    font-family: 'DM Mono', monospace;
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    margin-bottom: 1rem;
  }
  .coming {
    font-family: 'DM Mono', monospace;
    font-size: 0.82rem;
    color: var(--accent);
  }
</style>
