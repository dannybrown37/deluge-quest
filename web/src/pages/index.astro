---
import BaseLayout from '../layouts/BaseLayout.astro';
import DelugeUI from '../components/DelugeUI.svelte';
---

<BaseLayout title="Home" description="Browser-based tools for Synthstrom Deluge — score conversion, song inspection, MIDI import. No server, no upload, everything runs in your browser.">
  <section class="landing">
    <p class="first-visit-hint" id="first-visit-hint">try tapping a pad or spinning a knob ↓</p>
    <div class="deluge-desktop">
      <DelugeUI client:load />
    </div>
    <div class="mobile-hero">
      <h1 class="mobile-title">deluge.quest</h1>
      <p class="mobile-tagline">Browser-based tools for the Synthstrom Deluge. No server, no uploads — everything runs locally.</p>
      <nav class="mobile-tools">
        <a href="/stats" class="tool-card tool-card--stats">
          <span class="tool-icon">#</span>
          <span class="tool-name">Song Stats</span>
          <span class="tool-desc">Library analysis &amp; stats</span>
        </a>
        <a href="/preview" class="tool-card tool-card--preview">
          <span class="tool-icon">&#9703;</span>
          <span class="tool-name">Song Preview</span>
          <span class="tool-desc">Arrangement preview &amp; playback</span>
        </a>
        <a href="/score" class="tool-card tool-card--score">
          <span class="tool-icon">&#9835;</span>
          <span class="tool-name">Score Converter</span>
          <span class="tool-desc">Deluge XML → MusicXML</span>
        </a>
        <a href="/manage" class="tool-card tool-card--clean">
          <span class="tool-icon">&#9249;</span>
          <span class="tool-name">Card Management</span>
          <span class="tool-desc">Organize samples & songs</span>
        </a>
        <a href="/patch" class="tool-card tool-card--patch">
          <span class="tool-icon">&#9881;</span>
          <span class="tool-name">Patch Generator</span>
          <span class="tool-desc">Random synth presets</span>
        </a>
        <a href="https://github.com/dannybrown37/deluge" class="tool-card tool-card--github" target="_blank" rel="noopener">
          <span class="tool-icon">&#10097;</span>
          <span class="tool-name">Source</span>
          <span class="tool-desc">Open source on GitHub</span>
        </a>
      </nav>
    </div>
  </section>
</BaseLayout>

<script>
  const SESSION_KEY = 'dq-seen-hint';

  // Module scripts run once per session; ClientRouter swaps in a fresh banner on every
  // client-side nav back to /, so the wiring has to re-run per page load.
  function setupHint() {
    const banner = document.getElementById('first-visit-hint');
    if (!banner) return;

    if (sessionStorage.getItem(SESSION_KEY)) {
      banner.remove();
      return;
    }
    sessionStorage.setItem(SESSION_KEY, '1');
    banner.classList.add('show');

    const dismiss = () => banner.classList.remove('show');
    const desktop = document.querySelector('.deluge-desktop');
    desktop?.addEventListener('pointerdown', dismiss, { once: true });
    desktop?.addEventListener('wheel', dismiss, { once: true, passive: true });
    banner.addEventListener('transitionend', () => banner.remove(), { once: true });
  }

  setupHint();
  document.addEventListener('astro:after-swap', setupHint);
</script>

<style>
  .landing {
    position: relative;
    padding: 2rem 0.5rem 0;
    text-align: center;
    overflow: hidden;
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  .first-visit-hint {
    position: absolute;
    top: 0.5rem;
    left: 50%;
    transform: translateX(-50%);
    margin: 0;
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    letter-spacing: 0.03em;
    color: var(--text-secondary);
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    transition: opacity 0.4s ease;
  }

  /* Opt-in reveal: the server always ships this markup, so a default of opacity 0
     is what keeps it from flashing before the seen-this-session check runs. */
  .first-visit-hint.show {
    animation:
      hint-fade-in 0.4s ease both,
      hint-pulse 1.8s ease-in-out 0.4s infinite;
  }

  @keyframes hint-fade-in {
    from { opacity: 0; }
    to { opacity: 0.6; }
  }

  @keyframes hint-pulse {
    0%, 100% { opacity: 0.6; }
    50% { opacity: 1; }
  }

  :global(body:has(.landing)) {
    overflow: hidden;
    height: 100dvh;
    display: flex;
    flex-direction: column;
  }

  :global(body:has(.landing) .nav) {
    flex-shrink: 0;
  }

  :global(body:has(.landing) #main-content) {
    flex: 1;
    display: flex;
    flex-direction: column;
    min-height: 0;
  }

  :global(body:has(.landing) .footer) {
    display: none;
  }

  .deluge-desktop {
    display: flex;
    flex-direction: column;
    flex: 1;
    min-height: 0;
  }

  .mobile-hero {
    display: none;
  }

  @media (max-width: 700px) {
    .deluge-desktop { display: flex; }
    .mobile-hero { display: none; }
    .landing { padding: 2rem 0.25rem 0.25rem; }
  }

  .mobile-title {
    font-family: 'DM Mono', monospace;
    font-size: 1.8rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--accent);
    margin-bottom: 0.5rem;
  }

  .mobile-tagline {
    color: var(--text-secondary);
    font-size: 0.95rem;
    max-width: 340px;
    margin: 0 auto 2rem;
    line-height: 1.5;
  }

  .mobile-tools {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    max-width: 360px;
    margin: 0 auto;
  }

  .tool-card {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    padding: 1rem 1.25rem;
    border-radius: 8px;
    background: var(--surface);
    border: 1px solid var(--border);
    text-decoration: none;
    text-align: left;
    transition: border-color 0.08s, box-shadow 0.08s;
  }
  .tool-card:hover {
    text-decoration: none;
    border-color: var(--accent);
    box-shadow: 0 2px 12px var(--accent-dim);
  }

  .tool-icon {
    font-size: 1.4rem;
    width: 2rem;
    text-align: center;
    flex-shrink: 0;
  }
  .tool-card--score .tool-icon { color: var(--accent); }
  .tool-card--stats .tool-icon { color: var(--accent); font-family: 'DM Mono', monospace; }
  .tool-card--preview .tool-icon { color: var(--teal); }
  .tool-card--clean .tool-icon { color: var(--text-secondary); font-family: 'DM Mono', monospace; }
  .tool-card--patch .tool-icon { color: var(--teal); }
  .tool-card--github .tool-icon { color: var(--text-secondary); }

  .tool-name {
    font-family: 'DM Mono', monospace;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--text);
    display: block;
  }

  .tool-desc {
    font-size: 0.78rem;
    color: var(--text-secondary);
    display: block;
  }
</style>
