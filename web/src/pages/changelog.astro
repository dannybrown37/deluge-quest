---
import { getCollection, render } from "astro:content";
import BaseLayout from "../layouts/BaseLayout.astro";

const entries = (await getCollection("changelog")).sort(
  (a, b) => b.data.date.getTime() - a.data.date.getTime(),
);

const rendered = await Promise.all(
  entries.map(async (entry) => ({
    entry,
    Content: (await render(entry)).Content,
    dateStr: entry.data.date.toLocaleDateString("en-US", {
      year: "numeric",
      month: "short",
      day: "numeric",
      timeZone: "UTC",
    }),
    iso: entry.data.date.toISOString().slice(0, 10),
  })),
);

const tagColors: Record<string, string> = {
  feature: "var(--accent)",
  fix: "var(--teal)",
  improvement: "var(--text-secondary)",
};
---

<BaseLayout title="Changelog" description="What's new on deluge.quest">
  <section class="changelog">
    <h1 class="changelog-title">Changelog</h1>
    <p class="changelog-subtitle">Notable updates to deluge.quest — bug fixes, new features, and improvements.&ensp;<a href="/changelog/rss.xml" class="changelog-rss">RSS</a></p>
    <ol class="changelog-list">
      {rendered.map(({ entry, Content, dateStr, iso }) => (
        <li class="changelog-entry">
          <div class="changelog-meta">
            <time datetime={iso}>{dateStr}</time>
            <span class="changelog-tag" style={`color: ${tagColors[entry.data.tag]}`}>{entry.data.tag}</span>
          </div>
          <h2 class="changelog-entry-title">{entry.data.title}</h2>
          <div class="changelog-body">
            <Content />
          </div>
        </li>
      ))}
    </ol>
  </section>
</BaseLayout>

<style is:global>
  .changelog {
    max-width: 600px;
    margin: 0 auto;
    padding: 3rem 1.5rem 5rem;
  }
  .changelog-title {
    font-family: 'DM Mono', monospace;
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.25rem;
  }
  .changelog-subtitle {
    color: var(--text-secondary);
    font-size: 0.9rem;
    margin-bottom: 2rem;
  }
  .changelog-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .changelog-entry {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border);
  }
  .changelog-entry:first-child {
    padding-top: 0;
  }
  .changelog-meta {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 0.35rem;
  }
  .changelog-meta time {
    font-family: 'DM Mono', monospace;
    font-size: 0.8rem;
    color: var(--text-secondary);
  }
  .changelog-tag {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
  }
  .changelog-entry-title {
    font-family: 'DM Mono', monospace;
    font-size: 1rem;
    font-weight: 500;
    margin: 0 0 0.35rem;
  }
  .changelog-body {
    font-size: 0.9rem;
    line-height: 1.6;
  }
  .changelog-body p {
    margin-bottom: 0.5rem;
  }
  .changelog-body h2 {
    font-family: 'DM Mono', monospace;
    font-size: 0.95rem;
    font-weight: 500;
    margin-top: 1.25rem;
    margin-bottom: 0.4rem;
  }
  .changelog-body ul {
    list-style: none;
    padding: 0;
    margin-bottom: 0.75rem;
  }
  .changelog-body li {
    padding: 0.15rem 0;
  }
  .changelog-body ul > li::before {
    content: "→ ";
    color: var(--accent);
  }
  .changelog-body img {
    max-width: 100%;
    height: auto;
    border-radius: 6px;
    margin: 0.75rem 0;
  }
  .changelog-body pre {
    background: var(--surface);
    padding: 1rem;
    border-radius: 6px;
    overflow-x: auto;
    margin-bottom: 0.75rem;
  }
  .changelog-body pre code {
    background: none;
    padding: 0;
    font-size: 0.8rem;
  }
  .changelog-rss {
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.15rem 0.4rem;
    vertical-align: middle;
  }
  .changelog-rss:hover {
    text-decoration: none;
    border-color: var(--accent);
  }
</style>
