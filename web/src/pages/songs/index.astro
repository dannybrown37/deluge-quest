---
import fs from 'node:fs';
import path from 'node:path';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { parseFile } from 'music-metadata';

interface SongInfo {
  file: string;
  name: string;
  slug: string;
  year?: string;
  genre?: string;
  duration?: string;
}

function slugify(name: string): string {
  return name
    .toLowerCase()
    .replace(/[^a-z0-9]+/g, '-')
    .replace(/(^-|-$)/g, '');
}

function fmtDuration(seconds: number): string {
  const m = Math.floor(seconds / 60);
  const s = Math.floor(seconds % 60);
  return `${m}:${String(s).padStart(2, '0')}`;
}

const audioDir = path.join(process.cwd(), 'public', 'audio');
const files = fs.readdirSync(audioDir)
  .filter(f => /\.(mp3|wav|ogg|flac|m4a)$/i.test(f))
  .sort();

const songs: SongInfo[] = await Promise.all(files.map(async f => {
  const base = f.replace(/\.[^.]+$/, '');
  const m = base.match(/^(.*?)\s*\[([^\]]*)\]$/);
  const name = m ? m[1].trim() : base;
  const tags = m ? m[2].split(',').map(s => s.trim()).filter(Boolean) : [];
  let duration: string | undefined;
  try {
    const meta = await parseFile(path.join(audioDir, f));
    if (meta.format.duration) duration = fmtDuration(meta.format.duration);
  } catch {}
  return {
    file: f,
    name,
    slug: slugify(name),
    year: tags.find(t => /^\d{4}$/.test(t)),
    genre: tags.find(t => !/^\d{4}$/.test(t)),
    duration,
  };
}));

const byYear = [...songs].sort((a, b) => {
  const ya = parseInt(a.year ?? '0');
  const yb = parseInt(b.year ?? '0');
  return yb - ya || a.name.localeCompare(b.name);
});
---

<BaseLayout title="Songs" description="Tracks made on the Synthstrom Deluge">
  <div class="songs-page">
    <div class="page-title-row">
      <h1 class="page-title">Songs</h1>
      <span class="sort-btns">
        <button class="sort-btn sort-btn--active" data-sort="year">Year</button>
        <button class="sort-btn" data-sort="title">Title</button>
        <button class="sort-btn" data-sort="genre">Genre</button>
      </span>
    </div>
    <div class="page-sub-row">
      <p class="page-sub">Tracks I've made on the Synthstrom Deluge, recorded on the Deluge itself and compressed from WAV to MP3 with no post-processing.</p>

    </div>
    <ul class="song-list" id="song-list">
      {byYear.map(song => (
        <li data-year={song.year ?? '0'} data-genre={song.genre ?? ''} data-title={song.name}>
          <a href={`/songs/${song.slug}`} class="song-row">
            <span class="song-name">{song.name}</span>
            <span class="song-meta">
              {song.genre && <span class="song-genre">{song.genre}</span>}
              {song.year && <span class="song-year">{song.year}</span>}
              {song.duration && <span class="song-dur">{song.duration}</span>}
            </span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</BaseLayout>

<script>
  document.addEventListener('astro:page-load', () => {
    const list = document.getElementById('song-list');
    const btns = document.querySelectorAll<HTMLButtonElement>('.sort-btn');
    if (!list || !btns.length) return;

    function sortList(key: string) {
      const items = [...list!.querySelectorAll<HTMLElement>('li')];
      items.sort((a, b) => {
        if (key === 'year') {
          const ya = parseInt(a.dataset.year ?? '0');
          const yb = parseInt(b.dataset.year ?? '0');
          return yb - ya || (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
        }
        if (key === 'genre') {
          const ga = (a.dataset.genre ?? '').toLowerCase();
          const gb = (b.dataset.genre ?? '').toLowerCase();
          return ga.localeCompare(gb) || (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
        }
        return (a.dataset.title ?? '').localeCompare(b.dataset.title ?? '');
      });
      for (const item of items) list!.appendChild(item);
    }

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        btns.forEach(b => b.classList.remove('sort-btn--active'));
        btn.classList.add('sort-btn--active');
        sortList(btn.dataset.sort ?? 'year');
      });
    });
  });
</script>

<style>
  .songs-page {
    max-width: 600px;
    margin: 0 auto;
    padding: 2rem 1.5rem;
  }

  .page-title-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
    flex-wrap: wrap;
    margin-bottom: 0.25rem;
  }

  .page-title {
    font-family: 'DM Mono', monospace;
    font-size: 1.4rem;
    font-weight: 500;
    color: var(--text);
    margin: 0;
  }

  .page-sub-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin-bottom: 2rem;
    gap: 1rem;
  }

  .page-sub {
    font-size: 0.85rem;
    color: var(--text-secondary);
    margin: 0;
  }

  .sort-btns {
    display: flex;
    gap: 0.25rem;
  }

  .sort-btn {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-secondary);
    background: transparent;
    border: 1px solid var(--border);
    border-radius: 4px;
    padding: 0.2rem 0.5rem;
    cursor: pointer;
    transition: color 0.1s, border-color 0.1s;
  }
  .sort-btn:hover {
    color: var(--text);
    border-color: var(--text-secondary);
  }
  .sort-btn--active {
    color: var(--accent);
    border-color: var(--accent);
  }

  .song-list {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .song-row {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    padding: 0.75rem 0;
    border-bottom: 1px solid var(--border);
    text-decoration: none;
    gap: 1rem;
  }
  .song-row:hover {
    text-decoration: none;
  }
  .song-row:hover .song-name {
    color: var(--accent);
  }

  .song-name {
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
    color: var(--text);
    transition: color 0.1s;
    min-width: 0;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .song-meta {
    display: flex;
    gap: 0.5rem;
    flex-shrink: 0;
    align-items: baseline;
  }

  .song-genre {
    font-size: 0.7rem;
    color: var(--teal);
  }

  .song-year {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-secondary);
  }

  .song-dur {
    font-family: 'DM Mono', monospace;
    font-size: 0.7rem;
    color: var(--text-secondary);
    min-width: 3rem;
    text-align: right;
  }

  @media (max-width: 500px) {
    .songs-page { padding: 1.5rem 1rem; }
    .song-genre { display: none; }
  }
</style>
