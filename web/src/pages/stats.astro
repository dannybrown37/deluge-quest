---
import BaseLayout from '../layouts/BaseLayout.astro';
import SongAnalyzer from '../components/SongAnalyzer.svelte';
---

<BaseLayout title="Song Stats" description="Analyze your Deluge song library — tempo, key, duration, and more.">
  <section class="page-header">
    <h1 class="page-title">Song Stats</h1>
    <p class="page-desc">Sort and filter your Deluge songs by tempo, key, duration, and more.</p>
  </section>
  <section class="tool-area">
    <SongAnalyzer client:only="svelte" />
  </section>
  <section class="info">
    <div class="info-inner">
      <div class="info-block">
        <h3>How it works</h3>
        <p>Drop one or more <code>.XML</code> song files from your Deluge SD card. Each file is parsed to extract tempo, key, scale, instrument counts, clip counts, total notes, and arrangement duration.</p>
      </div>
      <div class="info-block">
        <h3>Sorting &amp; summary</h3>
        <p>Click any column header to sort. A summary at the bottom shows BPM range, total notes across all songs, and the most common keys in your library.</p>
      </div>
      <div class="info-block">
        <h3>Privacy</h3>
        <p>Everything runs in your browser via Python compiled to WebAssembly. No files are uploaded anywhere.</p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .page-header {
    max-width: 600px;
    margin: 0 auto;
    padding: 3rem 1.5rem 2rem;
    text-align: center;
  }
  .page-title {
    font-family: 'DM Mono', monospace;
    font-size: 1.5rem;
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  .page-desc {
    color: var(--text-secondary);
    font-size: 0.95rem;
    line-height: 1.6;
  }

  .tool-area {
    max-width: 900px;
    margin: 0 auto;
    padding: 0 1.5rem 3rem;
  }

  .info {
    border-top: 1px solid var(--border);
    padding: 3rem 1.5rem;
  }
  .info-inner {
    max-width: 960px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 2rem;
  }
  .info-block h3 {
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
    font-weight: 500;
    margin-bottom: 0.4rem;
  }
  .info-block p {
    font-size: 0.88rem;
    color: var(--text-secondary);
    line-height: 1.55;
  }
</style>
