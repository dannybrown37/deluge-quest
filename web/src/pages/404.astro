---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Page Not Found" description="This page doesn't exist.">
  <main id="main-content" style="display: flex; flex-direction: column; align-items: center; justify-content: center; min-height: 60vh; text-align: center; padding: 2rem;">
    <h1 style="font-family: 'DM Mono', monospace; font-size: 4rem; color: var(--gold); margin-bottom: 1rem;">404</h1>
    <p style="font-family: 'DM Sans', sans-serif; font-size: 1.25rem; margin-bottom: 2rem;">This page doesn't exist.</p>
    <a href="/" style="color: var(--gold); text-decoration: underline;">Back to deluge.quest</a>
  </main>
</BaseLayout>
