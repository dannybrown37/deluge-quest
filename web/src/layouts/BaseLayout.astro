---
import { ClientRouter } from "astro:transitions";

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Browser-based tools for Synthstrom Deluge" } =
  Astro.props;
const canonicalURL = new URL(Astro.url.pathname, "https://deluge.quest");
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — deluge.quest`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonicalURL.href} />
    <meta property="og:image" content="https://deluge.quest/og-image.png" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={`${title} — deluge.quest`} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content="https://deluge.quest/og-image.png" />
    <link rel="canonical" href={canonicalURL.href} />
    <title>{title} — deluge.quest</title>
    <link rel="icon" type="image/svg+xml" href="/grid-logo.svg" />
    <ClientRouter />
    <script defer src="https://cloud.umami.is/script.js" data-website-id="cf58cfd2-1688-412f-b1ba-899ea33208d5"></script>
  </head>
  <body>
    <a href="#main-content" class="skip-link">Skip to content</a>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-brand">
          <img class="nav-logo" src="/grid-logo.svg" alt="" width="40" height="20" />
          <span class="nav-name">deluge.quest</span>
        </a>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <div class="nav-links">
          <span class="nav-section-label">Tools</span>
          <a href="/manage" class="nav-link">Manage</a>
          <a href="/stats" class="nav-link">Stats</a>
          <a href="/preview" class="nav-link">Preview</a>
          <a href="/score" class="nav-link">Score</a>
          <a href="/kits" class="nav-link">Kits</a>
          <a href="/patch" class="nav-link">Patch</a>
          <a href="/import" class="nav-link">Import</a>
          <a href="/backup" class="nav-link">Backup</a>
          <span class="nav-section-label">The Site</span>
          <div class="nav-site-group">
          <button class="nav-site-toggle" aria-label="Site menu" aria-haspopup="true" aria-expanded="false">⋯</button>
          <div class="nav-site-dropdown">
            <a href="/faq" class="nav-link">FAQ</a>
            <a href="/songs" class="nav-link">Songs</a>
            <a href="/changelog" class="nav-link">Changelog</a>
            <a href="https://github.com/dannybrown37/deluge-quest" class="nav-link" target="_blank" rel="noopener">GitHub</a>
          </div>
          </div>
        </div>
      </div>
    </nav>
    <div id="mini-player" class="mini-player" style="display:none">
      <div class="mini-player-inner">
        <button id="mini-play-btn" class="mini-btn" aria-label="Play/Pause">
          <svg id="mini-play-icon" viewBox="0 0 12 12" width="10" height="10"><polygon points="2,0 12,6 2,12" fill="currentColor"/></svg>
          <svg id="mini-pause-icon" viewBox="0 0 12 12" width="10" height="10" style="display:none"><rect x="1" y="1" width="3.5" height="10" fill="currentColor"/><rect x="7.5" y="1" width="3.5" height="10" fill="currentColor"/></svg>
        </button>
        <div class="mini-info">
          <span id="mini-song-name" class="mini-song-name"></span>
          <span id="mini-time" class="mini-time"></span>
        </div>
        <a href="/" class="mini-home-link" aria-label="Go to player">⬡</a>
      </div>
    </div>
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <p>Open source tools for the <a href="https://synthstrom.com/product/deluge/" target="_blank" rel="noopener">Synthstrom Deluge</a></p>
      </div>
    </footer>

    <script>
      function initNavToggle() {
        const btn = document.querySelector('.nav-toggle');
        const links = document.querySelector('.nav-links');
        if (!btn || !links) return;

        btn.addEventListener('click', () => {
          const open = links.classList.toggle('nav-open');
          btn.classList.toggle('nav-toggle-open', open);
          btn.setAttribute('aria-expanded', String(open));
        });

        links.querySelectorAll('.nav-link').forEach(a => {
          a.addEventListener('click', () => {
            links.classList.remove('nav-open');
            btn.classList.remove('nav-toggle-open');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      }
      document.addEventListener('astro:page-load', initNavToggle);

      function initSiteMenu() {
        const btn = document.querySelector('.nav-site-toggle');
        const dropdown = document.querySelector('.nav-site-dropdown');
        if (!btn || !dropdown) return;

        const close = () => {
          dropdown.classList.remove('nav-site-open');
          btn.setAttribute('aria-expanded', 'false');
        };

        btn.addEventListener('click', (e) => {
          e.stopPropagation();
          const open = dropdown.classList.toggle('nav-site-open');
          btn.setAttribute('aria-expanded', String(open));
        });

        document.addEventListener('click', (e) => {
          if (!dropdown.classList.contains('nav-site-open')) return;
          if (e.target === btn || dropdown.contains(e.target as Node)) return;
          close();
        });

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape') close();
        });

        dropdown.querySelectorAll('.nav-link').forEach(a => {
          a.addEventListener('click', close);
        });
      }
      document.addEventListener('astro:page-load', initSiteMenu);
    </script>

    <script>
      import { trackToolVisit } from '../lib/analytics';
      // astro:page-load fires on the initial load too, so no separate first call.
      document.addEventListener('astro:page-load', () => trackToolVisit(window.location.pathname));
    </script>

    <script>
      import { homeAudio } from '../lib/homeAudio';

      function isPlayerPage() {
        const p = window.location.pathname;
        return p === '/' || p === '' || p.startsWith('/songs/');
      }

      function updateMiniPlayer() {
        const el = document.getElementById('mini-player');
        const nameEl = document.getElementById('mini-song-name');
        const timeEl = document.getElementById('mini-time');
        const playIcon = document.getElementById('mini-play-icon');
        const pauseIcon = document.getElementById('mini-pause-icon');
        if (!el) return;

        const shouldShow = !isPlayerPage() && (homeAudio.isPlaying || (homeAudio.songLoaded && homeAudio.playOffset > 0));
        el.style.display = shouldShow ? '' : 'none';

        if (shouldShow && nameEl && timeEl && playIcon && pauseIcon) {
          nameEl.textContent = homeAudio.currentSong?.name ?? '';
          timeEl.textContent = homeAudio.formatTime(homeAudio.elapsed, homeAudio.duration);
          playIcon.style.display = homeAudio.isPlaying ? 'none' : '';
          pauseIcon.style.display = homeAudio.isPlaying ? '' : 'none';
        }
      }

      homeAudio.subscribe(updateMiniPlayer);
      homeAudio.initMediaSession();

      document.addEventListener('astro:page-load', () => {
        homeAudio.reassertMediaSession();
        updateMiniPlayer();

        const btn = document.getElementById('mini-play-btn');
        btn?.addEventListener('click', () => {
          homeAudio.togglePlay();
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .skip-link {
    position: absolute;
    top: -100%;
    left: 1rem;
    z-index: 200;
    padding: 0.5rem 1rem;
    background: var(--accent);
    color: var(--ground);
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
    border-radius: 0 0 6px 6px;
    text-decoration: none;
  }
  .skip-link:focus-visible {
    top: 0;
  }

  .nav {
    border-bottom: 1px solid var(--border);
    background: var(--ground);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .nav-brand:hover { text-decoration: none; }
  .nav-brand:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 4px;
    border-radius: 4px;
  }
  .nav-logo {
    flex-shrink: 0;
    width: 40px;
    height: 20px;
  }
  .nav-name {
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }
  .nav-section-label {
    display: none;
  }
  .nav-link {
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
    padding: 0.5rem 0.25rem;
    margin: -0.5rem -0.25rem;
    border-radius: 4px;
  }
  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
  }
  .nav-link:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  /* Site menu (GitHub/FAQ/Songs) — icon + dropdown, stays collapsed at all widths */
  .nav-site-group {
    position: relative;
    display: flex;
    align-items: normal;
  }
  .nav-site-toggle {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 28px;
    height: 28px;
    padding: 0;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--text-secondary);
    font-size: 1rem;
    line-height: 1;
    cursor: pointer;
  }
  .nav-site-toggle:hover {
    color: var(--text);
  }
  .nav-site-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .nav-site-dropdown {
    display: none;
    position: absolute;
    top: calc(100% + 8px);
    right: 0;
    flex-direction: column;
    min-width: 160px;
    padding: 0.4rem;
    background: var(--ground);
    border: 1px solid var(--border);
    border-radius: 8px;
    box-shadow: 0 4px 16px rgba(0, 0, 0, 0.2);
    z-index: 10;
  }
  .nav-site-dropdown.nav-site-open {
    display: flex;
  }
  .nav-site-dropdown .nav-link {
    padding: 0.5rem 0;
    margin: 0;
    border-radius: 4px;
  }
  .nav-site-dropdown .nav-link:hover {
    background: var(--border);
  }

  /* Hamburger toggle */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
  }
  .nav-toggle:focus-visible {
    outline: 2px solid var(--accent);
    outline-offset: 2px;
  }
  .nav-toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text-secondary);
    border-radius: 1px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .nav-toggle-open .nav-toggle-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-toggle-open .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle-open .nav-toggle-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }
    .nav-links {
      display: none;
      position: absolute;
      top: 56px;
      left: 0;
      right: 0;
      background: var(--ground);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      padding: 0.5rem 1.5rem 1rem;
      gap: 0;
    }
    .nav-links.nav-open {
      display: flex;
    }
    .nav-link {
      padding: 0.6rem 0;
      margin: 0;
      font-size: 0.95rem;
      border-radius: 0;
      border-bottom: 1px solid var(--border);
    }
    .nav-link:last-child {
      border-bottom: none;
    }
    .nav-section-label {
      display: block;
      font-family: 'DM Mono', monospace;
      font-size: 0.7rem;
      font-weight: 500;
      color: var(--accent);
      text-transform: uppercase;
      letter-spacing: 0.08em;
      padding: 0.75rem 0 0.2rem;
    }
    .nav-section-label:first-child {
      padding-top: 0.25rem;
    }
    .nav-site-group {
      width: 100%;
    }
    .nav-site-toggle {
      display: none;
    }
    .nav-site-dropdown {
      display: flex;
      position: static;
      flex-direction: column;
      width: 100%;
      min-width: 0;
      padding: 0;
      background: none;
      border: none;
      box-shadow: none;
    }
    .nav-site-dropdown .nav-link {
      padding: 0.6rem 0;
      margin: 0;
      font-size: 0.95rem;
      border-radius: 0;
      border-bottom: 1px solid var(--border);
    }
    .nav-site-dropdown .nav-link:last-child {
      border-bottom: none;
    }
    .nav-site-dropdown .nav-link:hover {
      background: none;
    }
  }

  main {
    min-height: calc(100vh - 56px - 80px);
    overflow-x: hidden;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem;
  }
  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* Mini-player bar */
  .mini-player {
    background: #111114;
    border-bottom: 1px solid var(--border);
    z-index: 99;
  }
  .mini-player-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0.35rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mini-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    background: linear-gradient(180deg, #3A3A40 0%, #252528 40%, #1A1A1E 100%);
    box-shadow: 0 2px 1px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06);
    color: #D4A847;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .mini-btn:hover {
    box-shadow: 0 2px 1px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06), 0 0 8px rgba(212,168,71,0.3);
  }
  .mini-info {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
    flex: 1;
  }
  .mini-song-name {
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    color: #E0DDD6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mini-time {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    color: #777;
    flex-shrink: 0;
  }
  .mini-home-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 1rem;
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.15s;
  }
  .mini-home-link:hover { opacity: 1; }
</style>
