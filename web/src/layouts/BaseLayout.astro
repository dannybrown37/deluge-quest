---
import { ClientRouter } from 'astro:transitions';

interface Props {
  title: string;
  description?: string;
}

const { title, description = "Browser-based tools for Synthstrom Deluge" } = Astro.props;
---

<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={`${title} — DelugeKit`} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={`${title} — DelugeKit`} />
    <meta name="twitter:description" content={description} />
    <title>{title} — DelugeKit</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <ClientRouter />
  </head>
  <body>
    <nav class="nav">
      <div class="nav-inner">
        <a href="/" class="nav-brand">
          <span class="nav-logo">⬡</span>
          <span class="nav-name">DelugeKit</span>
        </a>
        <button class="nav-toggle" aria-label="Toggle menu" aria-expanded="false">
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
          <span class="nav-toggle-bar"></span>
        </button>
        <div class="nav-links">
          <a href="/manage" class="nav-link">Manage</a>
          <a href="/stats" class="nav-link">Stats</a>
          <a href="/preview" class="nav-link">Preview</a>
          <a href="/score" class="nav-link">Score</a>
          <a href="/kits" class="nav-link">Kits</a>
          <a href="/patch" class="nav-link">Patch</a>
          <a href="/import" class="nav-link">Import</a>
        </div>
      </div>
    </nav>
    <div id="mini-player" class="mini-player" style="display:none">
      <div class="mini-player-inner">
        <button id="mini-play-btn" class="mini-btn" aria-label="Play/Pause">
          <svg id="mini-play-icon" viewBox="0 0 12 12" width="10" height="10"><polygon points="2,0 12,6 2,12" fill="currentColor"/></svg>
          <svg id="mini-pause-icon" viewBox="0 0 12 12" width="10" height="10" style="display:none"><rect x="1" y="1" width="3.5" height="10" fill="currentColor"/><rect x="7.5" y="1" width="3.5" height="10" fill="currentColor"/></svg>
        </button>
        <div class="mini-info">
          <span id="mini-song-name" class="mini-song-name"></span>
          <span id="mini-time" class="mini-time"></span>
        </div>
        <a href="/" class="mini-home-link" aria-label="Go to player">⬡</a>
      </div>
    </div>
    <main>
      <slot />
    </main>
    <footer class="footer">
      <div class="footer-inner">
        <p>Open source tools for the <a href="https://synthstrom.com/product/deluge/" target="_blank" rel="noopener">Synthstrom Deluge</a></p>
      </div>
    </footer>

    <script>
      function initNavToggle() {
        const btn = document.querySelector('.nav-toggle');
        const links = document.querySelector('.nav-links');
        if (!btn || !links) return;

        btn.addEventListener('click', () => {
          const open = links.classList.toggle('nav-open');
          btn.classList.toggle('nav-toggle-open', open);
          btn.setAttribute('aria-expanded', String(open));
        });

        links.querySelectorAll('.nav-link').forEach(a => {
          a.addEventListener('click', () => {
            links.classList.remove('nav-open');
            btn.classList.remove('nav-toggle-open');
            btn.setAttribute('aria-expanded', 'false');
          });
        });
      }
      document.addEventListener('astro:page-load', initNavToggle);
    </script>

    <script>
      import { homeAudio } from '../lib/homeAudio';

      function isPlayerPage() {
        const p = window.location.pathname;
        return p === '/' || p === '' || p.startsWith('/songs/');
      }

      function updateMiniPlayer() {
        const el = document.getElementById('mini-player');
        const nameEl = document.getElementById('mini-song-name');
        const timeEl = document.getElementById('mini-time');
        const playIcon = document.getElementById('mini-play-icon');
        const pauseIcon = document.getElementById('mini-pause-icon');
        if (!el) return;

        const shouldShow = !isPlayerPage() && (homeAudio.isPlaying || (homeAudio.songLoaded && homeAudio.playOffset > 0));
        el.style.display = shouldShow ? '' : 'none';

        if (shouldShow && nameEl && timeEl && playIcon && pauseIcon) {
          nameEl.textContent = homeAudio.currentSong?.name ?? '';
          timeEl.textContent = homeAudio.formatTime(homeAudio.elapsed, homeAudio.duration);
          playIcon.style.display = homeAudio.isPlaying ? 'none' : '';
          pauseIcon.style.display = homeAudio.isPlaying ? '' : 'none';
        }
      }

      homeAudio.subscribe(updateMiniPlayer);
      homeAudio.initMediaSession();

      document.addEventListener('astro:page-load', () => {
        homeAudio.reassertMediaSession();
        updateMiniPlayer();

        const btn = document.getElementById('mini-play-btn');
        btn?.addEventListener('click', () => {
          homeAudio.togglePlay();
        });
      });
    </script>
  </body>
</html>

<style is:global>
  @import '../styles/global.css';
</style>

<style>
  .nav {
    border-bottom: 1px solid var(--border);
    background: var(--ground);
    position: sticky;
    top: 0;
    z-index: 100;
  }
  .nav-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0 1.5rem;
    height: 56px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text);
    text-decoration: none;
    font-weight: 700;
    font-size: 0.95rem;
  }
  .nav-brand:hover { text-decoration: none; }
  .nav-logo {
    font-size: 1.2rem;
    color: var(--accent);
  }
  .nav-name {
    font-family: 'DM Mono', monospace;
    font-weight: 500;
    letter-spacing: -0.01em;
  }
  .nav-links {
    display: flex;
    gap: 1.5rem;
  }
  .nav-link {
    font-family: 'DM Mono', monospace;
    font-size: 0.85rem;
    color: var(--text-secondary);
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--text);
    text-decoration: none;
  }

  /* Hamburger toggle */
  .nav-toggle {
    display: none;
    flex-direction: column;
    justify-content: center;
    gap: 4px;
    width: 36px;
    height: 36px;
    padding: 6px;
    background: none;
    border: 1px solid var(--border);
    border-radius: 6px;
    cursor: pointer;
  }
  .nav-toggle-bar {
    display: block;
    width: 100%;
    height: 2px;
    background: var(--text-secondary);
    border-radius: 1px;
    transition: transform 0.2s, opacity 0.2s;
  }
  .nav-toggle-open .nav-toggle-bar:nth-child(1) {
    transform: translateY(6px) rotate(45deg);
  }
  .nav-toggle-open .nav-toggle-bar:nth-child(2) {
    opacity: 0;
  }
  .nav-toggle-open .nav-toggle-bar:nth-child(3) {
    transform: translateY(-6px) rotate(-45deg);
  }

  @media (max-width: 768px) {
    .nav-toggle {
      display: flex;
    }
    .nav-links {
      display: none;
      position: absolute;
      top: 56px;
      left: 0;
      right: 0;
      background: var(--ground);
      border-bottom: 1px solid var(--border);
      flex-direction: column;
      padding: 0.5rem 1.5rem 1rem;
      gap: 0;
    }
    .nav-links.nav-open {
      display: flex;
    }
    .nav-link {
      padding: 0.6rem 0;
      font-size: 0.95rem;
      border-bottom: 1px solid var(--border);
    }
    .nav-link:last-child {
      border-bottom: none;
    }
  }

  main {
    min-height: calc(100vh - 56px - 80px);
    overflow-x: hidden;
  }

  .footer {
    border-top: 1px solid var(--border);
    padding: 1.5rem;
  }
  .footer-inner {
    max-width: 960px;
    margin: 0 auto;
    text-align: center;
    font-size: 0.85rem;
    color: var(--text-secondary);
  }

  /* Mini-player bar */
  .mini-player {
    background: #111114;
    border-bottom: 1px solid var(--border);
    z-index: 99;
  }
  .mini-player-inner {
    max-width: 960px;
    margin: 0 auto;
    padding: 0.35rem 1.5rem;
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .mini-btn {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    border: none;
    cursor: pointer;
    background: linear-gradient(180deg, #3A3A40 0%, #252528 40%, #1A1A1E 100%);
    box-shadow: 0 2px 1px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06);
    color: #D4A847;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
  }
  .mini-btn:hover {
    box-shadow: 0 2px 1px rgba(0,0,0,0.4), inset 0 1px 0 rgba(255,255,255,0.06), 0 0 8px rgba(212,168,71,0.3);
  }
  .mini-info {
    display: flex;
    align-items: baseline;
    gap: 0.75rem;
    min-width: 0;
    flex: 1;
  }
  .mini-song-name {
    font-family: 'DM Mono', monospace;
    font-size: 0.75rem;
    color: #E0DDD6;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .mini-time {
    font-family: 'DM Mono', monospace;
    font-size: 0.6rem;
    color: #777;
    flex-shrink: 0;
  }
  .mini-home-link {
    color: var(--accent);
    text-decoration: none;
    font-size: 1rem;
    flex-shrink: 0;
    opacity: 0.6;
    transition: opacity 0.15s;
  }
  .mini-home-link:hover { opacity: 1; }
</style>
